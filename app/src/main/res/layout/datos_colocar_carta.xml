<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#368DD3"
    android:orientation="vertical">


<!--    texto tipo carta-->
    <TextView
        android:id="@+id/claseCarta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#620A0A"
        android:fontFamily="@font/aldrich"
        android:gravity="center"
        android:text="Clase Carta"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/layout_datos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-3dp"
        android:padding="16dp"
        android:orientation="vertical">

        <!-- Nombre Carta -->
        <TextView
            android:id="@+id/c_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/baloo"
            android:gravity="center"
            android:text="Nombre Carta"
            android:textColor="#061535"
            android:textSize="20sp" />

        <!--    contenedor ataque y defensa-->
        <LinearLayout
            android:id="@+id/layout_atqYdef"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:orientation="horizontal">

<!--            Layout Ataque-->
            <LinearLayout
                android:id="@+id/layout_atq"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tituloAtk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/aldrich"
                    android:text="ATK: "
                    android:textColor="#161847"
                    android:textSize="16sp" />

                <!-- texto para setear ataque -->
                <TextView
                    android:id="@+id/c_atk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/aldrich"
                    android:text="0 + 0 "
                    android:textColor="#FFF"
                    android:textSize="16sp" />
            </LinearLayout>

<!--            layout defensa-->
            <LinearLayout
                android:id="@+id/layout_def"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="1dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tituloDef"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/aldrich"
                    android:text="DEF: "
                    android:textColor="#161847"
                    android:textSize="16sp" />

                <!-- texto para setear Defensa -->
                <TextView
                    android:id="@+id/c_def"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:fontFamily="@font/aldrich"
                    android:text="0 + 0"
                    android:textColor="#FFF"
                    android:textSize="16sp" />


            </LinearLayout>
        </LinearLayout>

<!--        layout descripcion-->
        <LinearLayout
            android:id="@+id/layout_descripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tituloDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:fontFamily="@font/aldrich"
                android:text="Descripcion: "
                android:textColor="#161847"
                android:textSize="16sp" />

            <!-- Descripcion -->
            <TextView
                android:id="@+id/c_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alata"
                android:text="Descripcion"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>

        <!--        layout Atributo-->
        <LinearLayout
            android:id="@+id/layout_atributo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tituloAtributo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:fontFamily="@font/aldrich"
                android:text="Atributo: "
                android:textColor="#161847"
                android:textSize="16sp" />

            <!-- Descripcion -->
            <TextView
                android:id="@+id/c_atributo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alata"
                android:text="ATRIBUTO"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>

        <!--        layout Tipo-->
        <LinearLayout
            android:id="@+id/layout_tipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tituloTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:fontFamily="@font/aldrich"
                android:text="Tipo: "
                android:textColor="#161847"
                android:textSize="16sp" />

            <!-- Descripcion -->
            <TextView
                android:id="@+id/c_tipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alata"
                android:text="Tipo"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>

        <!--        layout Carta enlazada (hacer .Gone en las demas tipos de carta no monstruos )-->
        <LinearLayout
            android:id="@+id/layout_CartaEnlazada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tituloCartaEnlazada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:fontFamily="@font/aldrich"
                android:text="Magica Enlazada:  "
                android:textColor="#161847"
                android:textSize="16sp" />

            <!-- Descripcion -->
            <TextView
                android:id="@+id/c_magicaEnlazada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alata"
                android:text="Ninguna"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>



        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#EE0E0E"
                android:text="Cancelar"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btn_accept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="#000099"
                android:text="Colocar"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
