        app:srcCompat="@drawable/m_dragonblancodeojosazules" />

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineFinal_MonstruosJugador"
        app:layout_constraintEnd_toStartOf="@+id/guidelineDer3_EspecialMaquina"
        app:layout_constraintStart_toStartOf="@+id/guidelineIzq_EspecialMaquina"
